{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'sem build de front-end nesta API'",
  "installCommand": "echo 'sem install de deps Node nesta API'",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/atualizar-cotacoes",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/atualizar-indicadores",
      "schedule": "5 20 * * *"
    }
  ],
  "env": {
    "LOG_CHANNEL": "stderr",
    "API_PREFIX": "",
    "REFRESH_COOKIE_SECURE": "true",
    "REFRESH_COOKIE_SAMESITE": "none",
    "VIEW_COMPILED_PATH": "/tmp",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php"
  }
}
